{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('posgrado.residentes-noimss.detalle') }}
    <style>
        .wrapper-came {
            margin-top: 20px;
            margin-bottom: 80px;
        }
    </style>
{% endblock %}

{% block body %}
    {{ render(controller('App\\Controller\\Posgrado\\PosgradoController::menu')) }}
    <div class="container-fluid wrapper-came">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <a href="{{ path('posgrado.residentes-imss.index', {tipo: 'no_imss'}) }}">Regresar</a>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <h1 style="text-align: center; padding-bottom: 40px">Alumnos extranjeros rotación parcial de especialidad</h1>
                </div>
            </div>
            <div id="residente-show-wrapper"></div>
            <div class="row">
                <div class="col-md-12">
                    <a href="{{ path('posgrado.residentes-imss.index', {tipo: 'no_imss'}) }}">Regresar</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.RESIDENTE_PROP = {{ residente|json_encode(constant('JSON_HEX_TAG'))|raw }};
        window.RESIDENTE = window.RESIDENTE_PROP;
    </script>
    {{ encore_entry_script_tags('posgrado.residentes-noimss.detalle') }}
{% endblock %}
