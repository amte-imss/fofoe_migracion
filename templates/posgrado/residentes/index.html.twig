{% extends 'layouts/app.html.twig' %}

{% block title %}Posgrado — {{ title }}{% endblock %}

{% block body %}
<div class="container-xl py-4">
    <div class="page-header mb-4">
        <h2 class="page-title">{{ title }}</h2>
        <div class="text-muted mt-1">Pantalla base migrada para conservar el acceso del menú.</div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="alert alert-info mb-0">
                Acceso habilitado para {{ tipo == 'no_imss' ? 'rotación parcial de especialidad' : 'ciclo académico anual' }}.
                La funcionalidad completa queda pendiente de migrar.
            </div>
        </div>
    </div>
</div>
{% endblock %}
