
<div class="captcha-container">
    <div class="form-group">
        <label for="_captcha">Introduce el código aquí</label>
        <input type="text" name="captcha" id="_captcha" required class="form-control form__input">
        <span class="help-block form__error _captcha-error"></span>
    </div>
    <div class="row">
        <div class="col-md-12">
            <img src="{{ captcha }}" id="captcha" alt="Captcha" class="img-responsive" style="display: inline-block">
            <a href="javascript:reload_captcha();">¡Generar nuevo código!</a>
        </div>
    </div>
</div>

<script type="text/javascript">
  function reload_captcha() {
    const img = document.getElementById('captcha');
    const xhttp = new XMLHttpRequest();
    xhttp.open("GET", "{{ absolute_url(path('reload_captcha')) }}", true);
    xhttp.onreadystatechange = function() {
      if (this.readyState === 4 && this.status === 200) {
        img.src = this.responseText;
      }
    };
    xhttp.send();
  }
</script>