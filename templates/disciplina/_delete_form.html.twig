<form method="post"
      action="{{ path('disciplina_delete', {'id': disciplina.id}) }}"
      onsubmit="return confirm('¿Estás seguro de borrar esta Disciplina?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ disciplina.id) }}">
    <button type="submit" class="btn btn-danger mb-2">Eliminar</button>
</form>
