{% extends 'layouts/app.html.twig' %}

{% block title %}Editar disciplina — FOFOE{% endblock %}

{% block stylesheets %}{{ encore_entry_link_tags('admin.convenio.styles') }}{% endblock %}

{% block body %}
    <div class="container-xl convenios-page py-4 py-lg-5">
        <a class="convenios-back" href="{{ path('disciplina_index') }}"><i class="ti ti-arrow-left"></i> Volver a disciplinas</a>
        <div class="convenios-heading mb-4">
            <div class="convenios-heading-icon"><i class="ti ti-edit"></i></div>
            <div><div class="convenios-eyebrow">Gestión de Convenios · #{{ disciplina.id }}</div><h1>Editar disciplina</h1><p>{{ disciplina.nombre }}</p></div>
        </div>
        <div class="convenios-card convenios-form-panel">
            <div class="convenios-card-header"><i class="ti ti-book"></i><span>Datos de la disciplina</span><span class="convenios-required">* Campos obligatorios</span></div>
            <div class="convenios-card-body">{{ include('disciplina/_form.html.twig', {form: edit_form}) }}</div>
        </div>
    </div>
{% endblock %}
