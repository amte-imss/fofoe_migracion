{% extends 'react_design/disciplinas-base.html.twig' %}

{% block title %}Disciplinas{% endblock %}

{% block body %}
    <div class="col-md-11 content">
        <div class="row" style="margin-left: 2%; margin-top: 3%;">
            <div class="col-md-12">
                <h3>Editar Disciplina</h3>
            </div>
            <div class="container containerCstmWidth">
                <div class="row rowCstmWidth">
                    <div class="col-md-12">
                        {{ form_start(edit_form) }}
                        {{ form_widget(edit_form) }}
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        {{ form_end(edit_form) }}
                        <div class="col-md-7" style="margin-top: -3%; margin-left: 15%;">
                            <a href="{{ url('disciplina_index', {'page': 1}) }}">Regresar a la Lista de Disciplinas</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
