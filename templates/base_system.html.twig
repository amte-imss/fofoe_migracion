<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8"/>
    <title>
        {% block title %}
            {% if app.request.pathInfo == '/login/convenio' %}
                Sistema de Información de Colaboraciones Académicas de la Coordinación de Educación en Salud (SICACES)
            {% else %}
                Sistema de Administración del FOFOE
            {% endif %}
        {% endblock %}
    </title>
    {% block stylesheets %}
        <link type="text/css" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/css/bootstrap.css" media="all">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Montserrat:200,300,400,600,700">
        <link rel="stylesheet" href="{{ asset('build/layout.css') }}">
    {% endblock %}
    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
    <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
    <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
    <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
</head>
<body>

{{ render(controller('App\\Controller\\DefaultController::header')) }}

{% block body %}{% endblock %}

{{ render(controller('App\\Controller\\DefaultController::footer')) }}

{% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    <script>
        window.SCHEMA_AND_HTTP_HOST = {{ url('homepage') | trim('/', side='right') | json_encode | raw }};
    </script>
    <script src="{{ asset('build/runtime.js') }}"></script>
{% endblock %}

</body>
</html>
