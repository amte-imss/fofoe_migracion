{% extends 'layouts/app.html.twig' %}

{% block title %}Detalle — Enfermería{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('enfermeria.show') }}
{% endblock %}

{% block body %}
    <div class="section-md">
        <div class="container-fluid">
            <div class="container">
                <h1 class="text-bold text-center mb-20">Detalle</h1>
                <div class="row">
                    <div class="col-md-12">
                        <div id="wrapper-page"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block extra_js %}
    <script>
        window.Solicitud = {{ solicitud | json_encode | raw }};
        window.Qr = '{{ qr }}';
    </script>
    {{ encore_entry_script_tags('enfermeria.show') }}
{% endblock %}
