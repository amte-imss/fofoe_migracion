{% extends 'layouts/app.html.twig' %}

{% block title %}Nueva solicitud de enfermería{% endblock %}

{% block body %}
    <div class="section-md">
        <div class="container-fluid">
            <div class="container">
                <h1 class="text-bold text-center mb-20">Nueva solicitud de enfermeria</h1>
                <div class="row">
                    <div class="col-md-12">
                        <div id="wrapper-page"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block extra_js %}
