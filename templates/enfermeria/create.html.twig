        window.escuelaId = '{{ escuelaId }}';
        window.asCame = {{ asCame ? 'true' : 'false' }};
        window.OOAD = '{{ ooad }}';
    </script>
    <script src="{{ asset('build/enfermeria.create.js') }}"></script>
{% endblock %}
