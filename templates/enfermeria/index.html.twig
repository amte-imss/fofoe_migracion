{% extends 'layouts/app.html.twig' %}

{% block title %}Historial — Enfermería{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('enfermeria.index') }}
{% endblock %}

{% block body %}
    <div class="section-md">
        <div class="container-fluid">
            <div class="container">
                <h1 class="text-bold text-center mb-20">Historial</h1>
                <div class="row">
                    <div class="col-md-12">
                        <div id="wrapper-page"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block extra_js %}
    <script>
        window.EscuelaID = '{{ escuelaId }}';
        window.asCame = {{ asCame ? 'true' : 'false' }};
        window.OOAD = '{{ ooad }}';
    </script>
    {{ encore_entry_script_tags('enfermeria.index') }}
{% endblock %}

