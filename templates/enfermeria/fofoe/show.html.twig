{% extends 'layouts/app.html.twig' %}

{% block title %}FOFOE — Detalle pago Enfermería #{{ pago.id }}{% endblock %}

{% block body %}
<div class="container-xl py-4">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="{{ path('fofoe.enfermeria.index') }}" class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-arrow-left"></i> Regresar
        </a>
        <h2 class="fw-bold mb-0">Detalle — Pago #{{ pago.id }}</h2>
    </div>

    <div class="row g-4">

        {# Datos del alumno #}
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header"><strong>Datos del alumno</strong></div>
                <div class="card-body">
                    {% set alumno = pago.escuelaEnfermeriaSolicitud %}
                    {% if alumno %}
                    <dl class="row mb-0">
                        <dt class="col-sm-5">N° alumno</dt>
                        <dd class="col-sm-7">{{ alumno.idFormatted }}</dd>
                        <dt class="col-sm-5">Nombre</dt>
                        <dd class="col-sm-7">{{ alumno.nombre }}</dd>
                        <dt class="col-sm-5">Email</dt>
                        <dd class="col-sm-7">{{ alumno.email }}</dd>
                        <dt class="col-sm-5">Estado</dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-secondary">{{ alumno.statusFormatted }}</span>
                        </dd>
                        {% if alumno.solicitud %}
                        <dt class="col-sm-5">Unidad</dt>
                        <dd class="col-sm-7">{{ alumno.solicitud.unidad.nombreEnfermeria ?? alumno.solicitud.unidad.nombre }}</dd>
                        <dt class="col-sm-5">Periodo</dt>
                        <dd class="col-sm-7">
                            {{ alumno.solicitud.fechaInicioFormatted }} — {{ alumno.solicitud.fechaFinFormatted }}
                        </dd>
                        {% endif %}
                    </dl>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Datos del pago #}
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header"><strong>Datos del pago</strong></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Referencia bancaria</dt>
                        <dd class="col-sm-7"><strong>{{ pago.referenciaBancaria }}</strong></dd>
                        <dt class="col-sm-5">Monto esperado</dt>
                        <dd class="col-sm-7">${{ pago.monto }}</dd>
                        <dt class="col-sm-5">Monto registrado</dt>
                        <dd class="col-sm-7">${{ pago.montoRegistrado ?? '—' }}</dd>
                        <dt class="col-sm-5">Fecha de pago</dt>
                        <dd class="col-sm-7">{{ pago.fechaPagoFormatted ?? '—' }}</dd>
                        <dt class="col-sm-5">Requiere factura</dt>
                        <dd class="col-sm-7">{{ pago.requiereFactura ? 'Sí' : 'No' }}</dd>
                        <dt class="col-sm-5">Estado</dt>
                        <dd class="col-sm-7">{{ pago.statusFormatted ?? '—' }}</dd>
                        {% if pago.observaciones %}
                        <dt class="col-sm-5">Observaciones</dt>
                        <dd class="col-sm-7 text-danger">{{ pago.observaciones }}</dd>
                        {% endif %}
                    </dl>

                    {% if pago.factura %}
                    <hr>
                    <p class="mb-1"><strong>Factura:</strong> {{ pago.factura.folio }}</p>
                    <p class="mb-0"><strong>Fecha:</strong> {{ pago.factura.fechaFacturacionFormatted }}</p>
                    <a href="{{ path('fofoe.pago.enfermeria.factura.download', {id: pago.factura.id}) }}"
                       class="btn btn-sm btn-outline-primary mt-2">
                        <i class="ti ti-download"></i> Descargar factura
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>

    {# Acciones FOFOE #}
    {% if pago.validado is null %}
    <div class="row g-3 mt-2">
        <div class="col-12">
            <div class="card border-warning">
                <div class="card-header bg-warning bg-opacity-10">
                    <strong>Validación del pago</strong>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2 flex-wrap">
                        {# Validar #}
                        <button class="btn btn-success" id="btn-validar">
                            <i class="ti ti-check"></i> Validar pago
                        </button>
                        {# Rechazar #}
                        <button class="btn btn-danger" id="btn-rechazar" data-bs-toggle="collapse" data-bs-target="#form-rechazo">
                            <i class="ti ti-x"></i> Rechazar pago
                        </button>
                    </div>

                    {# Formulario rechazo #}
                    <div class="collapse mt-3" id="form-rechazo">
                        <form id="form-rechazo-data">
                            <div class="mb-3">
                                <label class="form-label">Motivo del rechazo</label>
                                <textarea name="observaciones" class="form-control" rows="3" required></textarea>
                            </div>
                            <div class="mb-3 form-check">
                                <input type="checkbox" class="form-check-input" id="check-diferencia" name="has_diferencia">
                                <label class="form-check-label" for="check-diferencia">Hay diferencia de monto</label>
                            </div>
                            <div class="mb-3 d-none" id="campo-diferencia">
                                <label class="form-label">Monto de diferencia</label>
                                <input type="number" step="0.01" name="monto_diferencia" class="form-control">
                            </div>
                            <button type="submit" class="btn btn-danger">
                                <i class="ti ti-send"></i> Enviar rechazo
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {# Facturación #}
    {% if pago.validado == true and pago.requiereFactura and not pago.factura %}
    <div class="row g-3 mt-2">
        <div class="col-12">
            <div class="card border-primary">
                <div class="card-header bg-primary bg-opacity-10">
                    <strong>Carga de factura</strong>
                </div>
                <div class="card-body">
                    <form id="form-factura" enctype="multipart/form-data">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Fecha de factura</label>
                                <input type="date" name="factura[fechaFacturacion]" class="form-control" required>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Folio</label>
                                <input type="text" name="factura[folio]" class="form-control" required>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Monto</label>
                                <input type="number" step="0.01" name="factura[monto]" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Archivo (ZIP/PDF)</label>
                                <input type="file" name="factura[zipFile]" class="form-control" required>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">
                            <i class="ti ti-upload"></i> Enviar factura
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

</div>
{% endblock %}

{% block extra_js %}
<script>
const pagoId = {{ pago.id }};
const baseUrl = '';

// Validar pago
const btnValidar = document.getElementById('btn-validar');
if (btnValidar) {
    btnValidar.addEventListener('click', function () {
        if (!confirm('¿Confirmar validación del pago?')) return;
        fetch(`/fofoe/pagos/enfermeria/solicitud/${pagoId}/1`, {method: 'POST'})
            .then(r => r.json())
            .then(function (res) {
                if (res.status) { location.reload(); }
                else { alert('Error al validar.'); }
            });
    });
}

// Mostrar campo diferencia
const checkDiferencia = document.getElementById('check-diferencia');
if (checkDiferencia) {
    checkDiferencia.addEventListener('change', function () {
        document.getElementById('campo-diferencia').classList.toggle('d-none', !this.checked);
    });
}

// Enviar rechazo
const formRechazo = document.getElementById('form-rechazo-data');
if (formRechazo) {
    formRechazo.addEventListener('submit', function (e) {
        e.preventDefault();
        const data = new FormData(formRechazo);
        fetch(`/fofoe/pagos/enfermeria/solicitud/${pagoId}/0`, {method: 'POST', body: data})
            .then(r => r.json())
            .then(function (res) {
                if (res.status) { location.reload(); }
                else { alert('Error al rechazar.'); }
            });
    });
}

// Enviar factura
const formFactura = document.getElementById('form-factura');
if (formFactura) {
    formFactura.addEventListener('submit', function (e) {
        e.preventDefault();
        const data = new FormData(formFactura);
        fetch(`/fofoe/pagos/enfermeria/solicitud/${pagoId}/factura`, {method: 'POST', body: data})
            .then(r => r.json())
            .then(function (res) {
                if (res.status) { location.reload(); }
                else { alert('Error al cargar la factura.'); }
            });
    });
}
</script>
{% endblock %}
