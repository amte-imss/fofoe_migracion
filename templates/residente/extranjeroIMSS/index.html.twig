{% extends 'residente/extranjeroIMSS/_layout.html.twig' %}

{% block title %}Mi perfil — Residente FOFOE{% endblock %}

{% block body %}
    <div class="container resident-page py-4 py-md-5">
        <div class="resident-page-heading mb-4">
            <div class="resident-heading-icon"><i class="ti ti-user-circle"></i></div>
            <div><span class="resident-eyebrow">Portal del residente</span><h1>Mi perfil</h1><p>Consulta tus datos y el estado de tus pagos.</p></div>
        </div>
        <div id="main-component"></div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') %}
    <script>
        window.RESIDENTE_PROP = {{ residente|json_encode(json_flags)|raw }};
        window.ERRORS = {{ errores|json_encode(json_flags)|raw }};
        window.ACTION = {{ url('actualizar.datos')|json_encode(json_flags)|raw }};
    </script>
    {{ encore_entry_script_tags('residente.perfil') }}
{% endblock %}
