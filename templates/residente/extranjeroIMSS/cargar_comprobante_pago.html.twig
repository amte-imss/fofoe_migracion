{% extends 'residente/extranjeroIMSS/_layout.html.twig' %}

{% block title %}Cargar comprobante de pago — Residente FOFOE{% endblock %}

{% block body %}
    <div class="container resident-page py-4 py-md-5">
        <a class="resident-back" href="{{ path('residente.perfil') }}"><i class="ti ti-arrow-left"></i> Volver a mi perfil</a>
        <div class="resident-page-heading mb-4">
            <div class="resident-heading-icon"><i class="ti ti-file-upload"></i></div>
            <div><span class="resident-eyebrow">Pagos de residencia</span><h1>Cargar comprobante de pago</h1><p>Registra los datos del pago y adjunta el comprobante en PDF.</p></div>
        </div>
        <div id="cargar-de-comprobante-de-pago-component"></div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') %}
    <script>
        window.RESIDENCIA_PROPS = {{ residencia|json_encode(json_flags)|raw }};
        window.ERRORS_PROPS = {{ errors|json_encode(json_flags)|raw }};
        window.MONTO_A_PAGAR = {{ montoAPagar|json_encode(json_flags)|raw }};
    </script>
    {{ encore_entry_script_tags('residente.carga-comprobante-pago') }}
{% endblock %}
