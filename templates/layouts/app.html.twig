<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}IMSS — Sistema FOFOE{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta20/dist/css/tabler.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <style>
        :root {
            --imss-green:       #006847;
            --imss-green-dark:  #004d34;
            --imss-green-light: #e6f4ee;
        }
        .navbar-vertical { background: var(--imss-green-dark) !important; border-right: none; width: 260px; }
        .navbar-vertical .navbar-brand { padding: 1.25rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,.1); }
        .navbar-vertical .navbar-nav .nav-link {
            color: rgba(255,255,255,.75) !important; font-size: .85rem;
            border-radius: 6px; margin: 1px 8px; padding: 8px 12px;
            transition: background .15s, color .15s;
        }
        .navbar-vertical .navbar-nav .nav-link:hover,
        .navbar-vertical .navbar-nav .nav-link.active {
            background: rgba(255,255,255,.12) !important; color: #fff !important;
        }
        .navbar-vertical .navbar-nav .nav-link .nav-link-icon { color: rgba(255,255,255,.5); }
        .navbar-vertical .navbar-nav .nav-link:hover .nav-link-icon,
        .navbar-vertical .navbar-nav .nav-link.active .nav-link-icon { color: #fff; }
        .nav-section-label {
            font-size: .65rem; font-weight: 700; letter-spacing: .1em;
            text-transform: uppercase; color: rgba(255,255,255,.35); padding: 1rem 1.25rem .35rem;
        }
        .sidebar-user { border-top: 1px solid rgba(255,255,255,.1); padding: 1rem 1.5rem; }
        .sidebar-logo-text { color: #fff; font-weight: 700; font-size: 1rem; }
        .sidebar-logo-sub { color: rgba(255,255,255,.45); font-size: .7rem; letter-spacing: .05em; text-transform: uppercase; }
        .navbar-top {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 1040 !important;
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            height: 60px;
        }
        @media (min-width: 992px) {
            .with-sidebar .page-wrapper { margin-left: 260px !important; }
        }
        .navbar-vertical {
            display: flex;
            flex-direction: column;
            position: fixed !important;
            top: 60px !important;
            left: 0;
            height: calc(100vh - 60px) !important;
            z-index: 1030 !important;
        }
        .sidebar-nav-scroll {
            flex: 1;
            overflow-y: auto;
            padding-top: .5rem;
        }
        .page-wrapper { padding-top: 60px; }
        .kpi-card { border: none; border-radius: 12px; box-shadow: 0 1px 8px rgba(0,0,0,.06); transition: box-shadow .2s, transform .2s; }
        .kpi-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,.1); transform: translateY(-2px); }
        .kpi-icon { width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
        .module-card {
            border: 1px solid #f0f0f0; border-radius: 12px; background: #fff;
            box-shadow: 0 1px 6px rgba(0,0,0,.04);
            transition: box-shadow .2s, transform .2s, border-color .2s;
            cursor: pointer; text-decoration: none !important; display: block; color: inherit;
        }
        .module-card:hover { box-shadow: 0 6px 24px rgba(0,100,71,.13); transform: translateY(-3px); border-color: var(--imss-green); color: inherit; }
        .module-card .mod-icon { width: 52px; height: 52px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0; }
        .module-card .mod-title { font-weight: 600; font-size: .92rem; color: #212529; }
        .module-card .mod-sub { font-size: .78rem; color: #6c757d; margin-top: 1px; }
        .module-card .mod-arrow { color: #ced4da; font-size: 1rem; transition: color .15s; }
        .module-card:hover .mod-arrow { color: var(--imss-green); }
        .section-header { display: flex; align-items: center; gap: .6rem; margin-bottom: 1rem; }
        .section-header .section-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1rem; }
        .section-header .section-label { font-weight: 700; font-size: .8rem; text-transform: uppercase; letter-spacing: .07em; color: #495057; }
        .section-divider { flex: 1; height: 1px; background: #f0f0f0; margin-left: .5rem; }
        .role-chip { display: inline-flex; align-items: center; gap: 4px; background: var(--imss-green-light); color: var(--imss-green); border-radius: 20px; padding: 3px 12px; font-size: .75rem; font-weight: 600; }
        .welcome-banner { background: linear-gradient(135deg, var(--imss-green) 0%, #009b6a 100%); border-radius: 16px; color: #fff; padding: 1.75rem 2rem; position: relative; overflow: hidden; }
        .welcome-banner::after { content: '\eb04'; font-family: 'tabler-icons'; position: absolute; right: 2rem; top: 50%; transform: translateY(-50%); font-size: 6rem; color: rgba(255,255,255,.08); pointer-events: none; }
        .welcome-banner h3 { font-size: 1.25rem; font-weight: 700; margin-bottom: .25rem; }
        .welcome-banner p { font-size: .9rem; color: rgba(255,255,255,.8); margin: 0; }
        /* SPA transition */
        #page-content { transition: opacity .15s ease; }
        #page-content.loading { opacity: .4; pointer-events: none; }
        {% block extra_css %}{% endblock %}
    </style>
</head>
<body class="antialiased">
{% set isHome = app.request.pathInfo == '/' %}
<div class="wrapper{{ not isHome ? ' with-sidebar' : '' }}">

{# ═══ NAVBAR: full-width, siempre visible ═══ #}
<header class="navbar navbar-top" style="{{ isHome ? 'height:72px;' : '' }}">
    <div class="container-fluid px-4">
        <div class="me-auto d-flex align-items-center gap-3">
            <a href="{{ path('app_dashboard') }}" class="d-flex align-items-center text-decoration-none gap-3">
                <img src="/images/logo_IMSS_verde.png" alt="IMSS" style="height:{{ isHome ? '52px' : '44px' }};">
                <div class="d-none d-md-block" style="border-left:2px solid rgba(0,104,71,.2);padding-left:1rem;">
                    <div style="font-weight:700;font-size:{{ isHome ? '1rem' : '.9rem' }};color:var(--imss-green);line-height:1.2;">Instituto Mexicano del Seguro Social</div>
                    <div style="font-size:.72rem;color:#6c757d;text-transform:uppercase;letter-spacing:.05em;">Sistema de Administración FOFOE</div>
                </div>
            </a>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="d-none d-md-inline text-muted small">
                <i class="ti ti-calendar-event me-1"></i>{{ "now"|date("d/m/Y") }}
            </span>
            {% if app.user %}
            {% set primaryRole = '' %}
            {% for role in app.user.roles %}{% if role != 'ROLE_USER' and primaryRole == '' %}{% set primaryRole = role|replace({'ROLE_': ''})|lower|capitalize %}{% endif %}{% endfor %}
            {% if primaryRole %}
            <span class="badge" style="background:var(--imss-green-light);color:var(--imss-green);font-size:.72rem;font-weight:600;">
                <i class="ti ti-shield-check me-1"></i>{{ primaryRole }}
            </span>
            {% endif %}
            {% endif %}
            {% if app.user %}
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                    <span class="avatar avatar-sm" style="background:var(--imss-green);color:#fff;font-weight:700;font-size:.85rem;">
                        {{ app.user.getUserIdentifier()|first|upper }}
                    </span>
                    <span class="d-none d-md-inline small text-dark fw-semibold">{{ app.user.getUserIdentifier() }}</span>
                </a>
                <div class="dropdown-menu dropdown-menu-end">
                    <a href="{{ path('app_logout') }}" class="dropdown-item text-danger">
                        <i class="ti ti-logout me-2"></i>Cerrar sesión
                    </a>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</header>

{# ═══ SIDEBAR: solo visible dentro de módulos (no en el dashboard) ═══ #}
{% if not isHome %}
<aside class="navbar navbar-vertical navbar-expand-lg d-none d-lg-flex">
    <div class="container-fluid flex-column p-0">
        {# Menú de navegación #}
        <div class="sidebar-nav-scroll w-100">
        <div class="collapse navbar-collapse show" id="navbar-menu">
            <ul class="navbar-nav pt-1">

                <li class="nav-item">
                    <a class="nav-link spa-link {% if app.request.pathInfo == '/' %}active{% endif %}" href="{{ path('app_dashboard') }}">
                        <span class="nav-link-icon"><i class="ti ti-layout-dashboard"></i></span>
                        <span class="nav-link-title">Inicio</span>
                    </a>
                </li>

                {# ── Gestión Convenios ── #}
                {% if is_granted('ROLE_CONVENIOS') or is_granted('ROLE_CONVENIOS_OBSERVER') or is_granted('ROLE_SUPER') %}
                <div class="nav-section-label">Gestión Convenios</div>
                {% if is_granted('ROLE_CONVENIOS') or is_granted('ROLE_SUPER') %}
                <li class="nav-item"><a class="nav-link spa-link {{ app.request.pathInfo starts with '/admin/conveniosadmin' ? 'active' : '' }}" href="{{ path('admin.conveniosadmin.conveniosadmin.index') }}"><span class="nav-link-icon"><i class="ti ti-file-certificate"></i></span><span class="nav-link-title">Convenios CAME</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link {{ app.request.pathInfo starts with '/admin/convenios-especiales' ? 'active' : '' }}" href="{{ path('admin.convenios-especiales.index') }}"><span class="nav-link-icon"><i class="ti ti-file-star"></i></span><span class="nav-link-title">Convenios Especiales</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link {{ app.request.pathInfo starts with '/admin/coordfirmante' ? 'active' : '' }}" href="{{ path('admin.coordfirmante.coordfirmante.index') }}"><span class="nav-link-icon"><i class="ti ti-users"></i></span><span class="nav-link-title">Catálogo Coord. Firmante</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link {{ app.request.pathInfo starts with '/admin/disciplina' ? 'active' : '' }}" href="{{ path('disciplina_index') }}"><span class="nav-link-icon"><i class="ti ti-book"></i></span><span class="nav-link-title">Catálogo de Disciplinas</span></a></li>
                {% endif %}
                <li class="nav-item"><a class="nav-link spa-link {{ app.request.pathInfo starts with '/admin/institucion' ? 'active' : '' }}" href="{{ path('admin.institucion.index') }}"><span class="nav-link-icon"><i class="ti ti-building"></i></span><span class="nav-link-title">Instituciones Educativas</span></a></li>
                {% endif %}

                {# ── Gestión FOFOE ── #}
                {% if is_granted('ROLE_FOFOE_INICIO') or is_granted('ROLE_ADM_FOFOE') or is_granted('ROLE_SUPER') %}
                <div class="nav-section-label">Gestión FOFOE</div>
                <li class="nav-item"><a class="nav-link spa-link {{ app.request.pathInfo starts with '/fofoe/resumen' ? 'active' : '' }}" href="{{ path('fofoe.resumen_pagos') }}"><span class="nav-link-icon"><i class="ti ti-report-money"></i></span><span class="nav-link-title">Resumen Pagos Recibidos</span></a></li>
                {% if is_granted('ROLE_FOFOE_REPORTE_INGS') or is_granted('ROLE_FOFOE_REPORTE_OP') or is_granted('ROLE_SUPER') %}
                <li class="nav-item"><a class="nav-link spa-link {{ app.request.pathInfo == '/fofoe/reportes/' ? 'active' : '' }}" href="{{ path('fofoe.reportes') }}"><span class="nav-link-icon"><i class="ti ti-chart-bar"></i></span><span class="nav-link-title">Reportes</span></a></li>
                {% endif %}
                <li class="nav-item"><a class="nav-link spa-link {{ app.request.pathInfo starts with '/fofoe/reportes/pagos' ? 'active' : '' }}" href="{{ path('fofoe.reportes.pagos') }}"><span class="nav-link-icon"><i class="ti ti-file-dollar"></i></span><span class="nav-link-title">Reporte de pagos</span></a></li>
                {% if is_granted('ROLE_FOFOE_DETALLE_INSTITUCION_EDUCATIVA') or is_granted('ROLE_SUPER') %}
                <li class="nav-item"><a class="nav-link spa-link {{ app.request.pathInfo starts with '/fofoe/instituciones/pendientes' ? 'active' : '' }}" href="{{ path('fofoe.instituciones.pendientes') }}"><span class="nav-link-icon"><i class="ti ti-building-check"></i></span><span class="nav-link-title">Instituciones por validar</span></a></li>
                {% endif %}
                {% endif %}

                {# ── Posgrado ── #}
                {% if is_granted('ROLE_POSGRADO') or is_granted('ROLE_CAME') or is_granted('ROLE_SUPER') %}
                <div class="nav-section-label">Posgrado</div>
                <li class="nav-item"><a class="nav-link spa-link {{ app.request.pathInfo == '/posgrado/residentes/imss' ? 'active' : '' }}" href="{{ path('posgrado.residentes-imss.index', {tipo: 'imss'}) }}"><span class="nav-link-icon"><i class="ti ti-user-plus"></i></span><span class="nav-link-title">Alumnos extranjeros en Ciclo académico anual</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link {{ app.request.pathInfo == '/posgrado/residentes/no_imss' ? 'active' : '' }}" href="{{ path('posgrado.residentes-imss.index', {tipo: 'no_imss'}) }}"><span class="nav-link-icon"><i class="ti ti-user-check"></i></span><span class="nav-link-title">Alumnos extranjeros rotación parcial de especialidad</span></a></li>
                {% endif %}

                {# ── Campos Clínicos ── #}
                {% if is_granted('ROLE_CAME') or is_granted('ROLE_JDES') or is_granted('ROLE_SUPER') %}
                <div class="nav-section-label">Campos Clínicos</div>
                <li class="nav-item"><a class="nav-link spa-link {{ app.request.pathInfo starts with '/came' ? 'active' : '' }}" href="{{ path('came.solicitud.index') }}"><span class="nav-link-icon"><i class="ti ti-calendar-event"></i></span><span class="nav-link-title">Ciclos Educativos</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link" href="#"><span class="nav-link-icon"><i class="ti ti-file-certificate"></i></span><span class="nav-link-title">Convenios</span></a></li>
                {% if is_granted('ROLE_CAME') or is_granted('ROLE_SUPER') %}
                <li class="nav-item"><a class="nav-link spa-link" href="{{ path('enfermeria.index') }}"><span class="nav-link-icon"><i class="ti ti-nurse"></i></span><span class="nav-link-title">Escuelas de Enfermería</span></a></li>
                {% endif %}
                {% endif %}

                {# ── Simulación ── #}
                {% if is_granted('ROLE_SIMULACION') or is_granted('ROLE_SUPER') %}
                <div class="nav-section-label">Simulación</div>
                <li class="nav-item"><a class="nav-link spa-link" href="#"><span class="nav-link-icon"><i class="ti ti-device-desktop"></i></span><span class="nav-link-title">Solicitudes Simulación</span></a></li>
                {% endif %}

                {# ── Enfermería ── #}
                {% if is_granted('ROLE_ENFERMERIA') or is_granted('ROLE_SUPER') %}
                <div class="nav-section-label">Enfermería</div>
                <li class="nav-item"><a class="nav-link spa-link {% if app.request.pathInfo starts with '/enfermeria' %}active{% endif %}" href="{{ path('enfermeria.index') }}"><span class="nav-link-icon"><i class="ti ti-stethoscope"></i></span><span class="nav-link-title">Escuelas de Enfermería</span></a></li>
                {% endif %}

                {# ── Edu. Permanente ── #}
                {% if is_granted('ROLE_EDU_PER') or is_granted('ROLE_SUPER') %}
                <div class="nav-section-label">Educación Permanente</div>
                <li class="nav-item"><a class="nav-link spa-link" href="#"><span class="nav-link-icon"><i class="ti ti-school"></i></span><span class="nav-link-title">Solicitudes Edu. Per.</span></a></li>
                {% endif %}

                {# ── Catálogos Generales ── #}
                {% if is_granted('ROLE_SUPER') %}
                <div class="nav-section-label">Catálogos Generales</div>
                <li class="nav-item"><a class="nav-link spa-link" href="#"><span class="nav-link-icon"><i class="ti ti-map"></i></span><span class="nav-link-title">Regiones</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link" href="#"><span class="nav-link-icon"><i class="ti ti-map-pin"></i></span><span class="nav-link-title">Delegaciones</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link" href="#"><span class="nav-link-icon"><i class="ti ti-building-hospital"></i></span><span class="nav-link-title">Unidades</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link" href="#"><span class="nav-link-icon"><i class="ti ti-category"></i></span><span class="nav-link-title">Carreras</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link" href="#"><span class="nav-link-icon"><i class="ti ti-list"></i></span><span class="nav-link-title">Departamentos</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link" href="#"><span class="nav-link-icon"><i class="ti ti-tag"></i></span><span class="nav-link-title">Categorías</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link" href="#"><span class="nav-link-icon"><i class="ti ti-certificate"></i></span><span class="nav-link-title">Especialidades</span></a></li>
                {% endif %}

                {# ── Administración ── #}
                {% if is_granted('ROLE_SUPER') or is_granted('ROLE_ADM_FOFOE') %}
                <div class="nav-section-label">Administración</div>
                <li class="nav-item"><a class="nav-link spa-link" href="{{ path('admin.usuarios.index') }}"><span class="nav-link-icon"><i class="ti ti-users"></i></span><span class="nav-link-title">Usuarios</span></a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('admin.enfermeria.solicitudes.index') }}"><span class="nav-link-icon"><i class="ti ti-nurse"></i></span><span class="nav-link-title">Solicitudes Enfermería</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link" href="#"><span class="nav-link-icon"><i class="ti ti-list-details"></i></span><span class="nav-link-title">Bitácora</span></a></li>
                {% if is_granted('ROLE_SUPER') %}
                <li class="nav-item"><a class="nav-link spa-link" href="{{ path('admin.permisos.index') }}"><span class="nav-link-icon"><i class="ti ti-shield-lock"></i></span><span class="nav-link-title">Permisos</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link" href="{{ path('admin.roles.index') }}"><span class="nav-link-icon"><i class="ti ti-user-shield"></i></span><span class="nav-link-title">Roles</span></a></li>
                <li class="nav-item"><a class="nav-link spa-link" href="#"><span class="nav-link-icon"><i class="ti ti-adjustments-horizontal"></i></span><span class="nav-link-title">Configuración Global</span></a></li>
                {% endif %}
                {% endif %}

            </ul>
        </div>{# /collapse #}
        </div>{# /sidebar-nav-scroll #}

            {% if app.user %}
            <div class="mt-auto sidebar-user">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-sm" style="background:rgba(255,255,255,.2);color:#fff;font-weight:700;">
                        {{ app.user.getUserIdentifier()|first|upper }}
                    </span>
                    <div class="overflow-hidden flex-fill">
                        <div class="text-white small fw-semibold text-truncate">{{ app.user.getUserIdentifier() }}</div>
                        <div style="color:rgba(255,255,255,.45);font-size:.7rem;">
                            {% for role in app.user.roles %}{% if role != 'ROLE_USER' and loop.first %}{{ role|replace({'ROLE_': ''})|lower|capitalize }}{% endif %}{% endfor %}
                        </div>
                    </div>
                    <a href="{{ path('app_logout') }}" title="Cerrar sesión" style="color:rgba(255,255,255,.4);font-size:1.1rem;">
                        <i class="ti ti-logout"></i>
                    </a>
                </div>
            </div>
            {% endif %}
        </div>{# /container-fluid #}
</aside>
{% endif %}

{# ═══ CONTENIDO ═══ #}
<div class="page-wrapper">
    <div class="page-body">
        <div id="page-content">
            {% block body %}{% endblock %}
        </div>
    </div>

    <footer class="footer footer-transparent d-print-none">
        <div class="container-xl">
            <div class="text-center text-muted py-3" style="font-size:.78rem;">
                IMSS © {{ "now"|date("Y") }} — Sistema FOFOE &nbsp;·&nbsp; Todos los derechos reservados
            </div>
        </div>
    </footer>
</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta20/dist/js/tabler.min.js"></script>
<script>
// ── Navegación SPA: intercepta .spa-link, carga solo #page-content ──
(function () {
    function navigate(url, pushState) {
        const content = document.getElementById('page-content');
        content.classList.add('loading');

        fetch(url, { headers: { 'X-SPA-Request': '1' } })
            .then(r => r.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newContent = doc.getElementById('page-content');
                const newTitle = doc.querySelector('title');

                if (newContent) {
                    content.innerHTML = newContent.innerHTML;
                }
                if (newTitle) {
                    document.title = newTitle.textContent;
                }
                if (pushState) {
                    history.pushState({ url }, '', url);
                }

                // Actualizar active en sidebar
                document.querySelectorAll('.spa-link').forEach(a => {
                    a.classList.toggle('active', a.getAttribute('href') === url);
                });

                content.classList.remove('loading');
                // Re-ejecutar scripts inline del nuevo contenido
                content.querySelectorAll('script').forEach(s => {
                    const ns = document.createElement('script');
                    ns.textContent = s.textContent;
                    document.body.appendChild(ns).remove();
                });
            })
            .catch(() => {
                // Fallback: carga normal
                window.location.href = url;
            });
    }

    // Delegación de eventos en sidebar (solo .spa-link)
    document.addEventListener('click', function (e) {
        const link = e.target.closest('.spa-link');
        if (!link) return;
        const href = link.getAttribute('href');
        if (!href || href === '#') return;
        e.preventDefault();
        // Si el destino o el origen es la raíz, recarga completa para mostrar/ocultar sidebar
        const isCurrentHome = window.location.pathname === '/';
        const isTargetHome  = href === '/';
        if (isTargetHome || isCurrentHome) {
            window.location.href = href;
            return;
        }
        navigate(href, true);
    });

    // Botón atrás/adelante del navegador
    window.addEventListener('popstate', function (e) {
        navigate(e.state?.url || window.location.pathname, false);
    });
})();
</script>
{% block extra_js %}{% endblock %}
</body>
</html>
