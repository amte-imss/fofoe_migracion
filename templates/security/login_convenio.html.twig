{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('login') }}
{% endblock %}

{% block body %}
    <div id="content-wrapper-login"></div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('login') }}
    <script>
        {% if error is not null %}
        window.ERROR        = {{ error.messageKey | trans(error.messageData, 'security') | json_encode | raw }};
        {% endif %}
        window.TIPO         = {{ tipo          | json_encode | raw }};
        window.PATH_LOGIN   = {{ path_login    | json_encode | raw }};
        window.LAST_USERNAME = {{ last_username | json_encode | raw }};
        window.CAPTCHA      = {{ render(controller('App\\Controller\\CaptchaController::reload')) | json_encode | raw }};
        {% if showImage %}
        window.URL_IMG      = {{ absolute_url(asset('build/images/login-background_2.jpeg')) | json_encode | raw }};
        {% else %}
        window.URL_IMG      = '';
        {% endif %}
    </script>
{% endblock %}
