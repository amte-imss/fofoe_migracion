<form method="post"
      action="{{ path('admin.coordfirmante.coordfirmante.delete', {'id': coordinacion.id}) }}"
      onsubmit="return confirm('¿Estás seguro de borrar esta Coordinación Firmante?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ coordinacion.id) }}">
    <button type="submit" class="btn btn-danger mb-2">Eliminar</button>
</form>
