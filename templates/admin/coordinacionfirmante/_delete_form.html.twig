<form method="post" action="{{ path('admin.coordfirmante.coordfirmante.delete', {id: coordinacion.id}) }}" onsubmit="return confirm('¿Estás seguro de borrar esta coordinación firmante?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ coordinacion.id) }}">
    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="ti ti-trash me-1"></i>Eliminar</button>
</form>
