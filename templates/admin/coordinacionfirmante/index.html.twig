{% extends 'layouts/app.html.twig' %}

{% block title %}Coordinaciones firmantes — FOFOE{% endblock %}

{% block stylesheets %}{{ encore_entry_link_tags('admin.convenio.styles') }}{% endblock %}

{% block body %}
    <div class="container-xl convenios-page py-4 py-lg-5">
        <div class="convenios-heading mb-4">
            <div class="convenios-heading-icon"><i class="ti ti-users"></i></div>
            <div>
                <div class="convenios-eyebrow">Gestión de Convenios</div>
                <h1>Coordinaciones firmantes</h1>
                <p>Consulta y administra las coordinaciones firmantes de convenios.</p>
            </div>
        </div>

        <div class="convenios-card convenios-filters mb-4">
            <div class="convenios-card-header"><i class="ti ti-adjustments-horizontal"></i><span>Buscar coordinaciones</span></div>
            <div class="convenios-card-body">
                <form action="{{ path('admin.coordfirmante.coordfirmante.index') }}" method="get" autocomplete="off">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-8 col-xl-6">
                            <label for="coordinacionToSearch" class="form-label">Nombre de la coordinación</label>
                            <div class="convenios-search-controls">
                                <input class="form-control" type="search" id="coordinacionToSearch" name="coordinacionToSearch" value="{{ coordinacionToSearch }}" placeholder="Buscar por nombre">
                                <button class="btn convenios-btn-primary" type="submit"><i class="ti ti-search me-1"></i>Buscar</button>
                            </div>
                        </div>
                    </div>
                </form>
                {% if coordinacionToSearch is not empty %}
                    <a class="btn btn-link convenios-clear px-0 mt-3" href="{{ path('admin.coordfirmante.coordfirmante.index') }}"><i class="ti ti-filter-off me-1"></i>Limpiar búsqueda</a>
                {% endif %}
            </div>
        </div>

        {% if message|trim is not empty %}
            <div class="alert alert-{{ message starts with 'La Coordinación' ? 'success' : 'danger' }}" role="alert">{{ message }}</div>
        {% endif %}

        <div class="convenios-toolbar mb-3">
            <div><strong>{{ totalRegistros }}</strong> coordinaciones encontradas</div>
            <div class="convenios-toolbar-actions">
                {% if not is_convenios_observer %}
                    <a class="btn convenios-btn-primary" href="{{ path('admin.coordfirmante.coordfirmante.new') }}"><i class="ti ti-plus me-1"></i>Nueva coordinación</a>
                {% endif %}
                <a class="btn btn-outline-success" href="{{ path('admin.coordfirm.export') }}"><i class="ti ti-download me-1"></i>Exportar</a>
            </div>
        </div>

        <div class="convenios-card convenios-list-card">
            <div class="table-responsive">
                <table class="table table-hover convenios-table convenios-table--coordinaciones">
                    <thead><tr>
                        <th>Número</th><th>Nombre</th><th>Estado</th><th>Registro</th><th>Fecha de creación</th><th>Última modificación</th><th>Acciones</th>
                    </tr></thead>
                    <tbody>
                        {% for coordinacion in coordinaciones %}
                            <tr>
                                <td><span class="convenios-number">{{ coordinacion.id }}</span></td>
                                <td>{{ coordinacion.nombre }}</td>
                                <td><span class="convenios-status convenios-status--{{ coordinacion.activa ? 'active' : 'inactive' }}">{{ coordinacion.activa ? 'Activa' : 'Inactiva' }}</span></td>
                                <td><span class="convenios-status convenios-status--{{ coordinacion.borrado ? 'deleted' : 'active' }}">{{ coordinacion.borrado ? 'Borrada' : 'Vigente' }}</span></td>
                                <td>{{ coordinacion.fechaCreacion ? coordinacion.fechaCreacion|date('d-m-Y') : '—' }}</td>
                                <td>{{ coordinacion.fechaModificacion ? coordinacion.fechaModificacion|date('d-m-Y') : '—' }}</td>
                                <td class="convenios-actions-cell">
                                    {% if not is_convenios_observer %}
                                        <div class="convenios-row-actions">
                                            <a class="btn btn-sm btn-outline-primary" href="{{ path('admin.coordfirmante.coordfirmante.edit', {id: coordinacion.id}) }}"><i class="ti ti-edit me-1"></i>Editar</a>
                                            {{ include('admin/coordinacionfirmante/_delete_form.html.twig') }}
                                        </div>
                                    {% else %}—{% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7" class="convenios-empty"><i class="ti ti-users-off"></i><strong>No se encontraron coordinaciones</strong><span>Prueba con otro nombre o registra una coordinación nueva.</span></td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if totalRegistros > 0 %}
                <div class="convenios-pagination d-flex justify-content-between align-items-center gap-3 flex-wrap">
                    <span>Mostrando {{ minLimit }}–{{ maxLimit }} de {{ totalRegistros }}</span>
                    {% set paginationParams = {coordinacionToSearch: coordinacionToSearch} %}
                    <nav aria-label="Paginación de coordinaciones">
                        <ul class="pagination">
                            <li class="{{ isTheLFirstPage ? 'disabled' : '' }}"><a href="{{ isTheLFirstPage ? '#' : path('admin.coordfirmante.coordfirmante.index', paginationParams|merge({page: 1})) }}" aria-label="Primera página">Primera</a></li>
                            <li class="{{ isTheLFirstPage ? 'disabled' : '' }}"><a href="{{ isTheLFirstPage ? '#' : path('admin.coordfirmante.coordfirmante.index', paginationParams|merge({page: anterior})) }}" aria-label="Página anterior">Anterior</a></li>
                            <li class="{{ isTheLastPage ? 'disabled' : '' }}"><a href="{{ isTheLastPage ? '#' : path('admin.coordfirmante.coordfirmante.index', paginationParams|merge({page: siguiente})) }}" aria-label="Página siguiente">Siguiente</a></li>
                            <li class="{{ isTheLastPage ? 'disabled' : '' }}"><a href="{{ isTheLastPage ? '#' : path('admin.coordfirmante.coordfirmante.index', paginationParams|merge({page: totalPaginas})) }}" aria-label="Última página">Última</a></li>
                        </ul>
                    </nav>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
