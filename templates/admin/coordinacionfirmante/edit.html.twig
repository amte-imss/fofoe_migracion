{% extends 'layouts/app.html.twig' %}

{% block title %}Editar coordinación firmante — FOFOE{% endblock %}

{% block stylesheets %}{{ encore_entry_link_tags('admin.convenio.styles') }}{% endblock %}

{% block body %}
    <div class="container-xl convenios-page py-4 py-lg-5">
        <a class="convenios-back" href="{{ path('admin.coordfirmante.coordfirmante.index') }}"><i class="ti ti-arrow-left"></i> Volver a coordinaciones</a>
        <div class="convenios-heading mb-4">
            <div class="convenios-heading-icon"><i class="ti ti-edit"></i></div>
            <div>
                <div class="convenios-eyebrow">Gestión de Convenios</div>
                <h1>Editar coordinación firmante</h1>
                <p>{{ form.nombre.vars.value }}</p>
            </div>
        </div>
        <div class="convenios-card convenios-form-panel">
            <div class="convenios-card-header"><i class="ti ti-users"></i><span>Datos de la coordinación</span><span class="convenios-required">* Campos obligatorios</span></div>
            <div class="convenios-card-body">{{ include('admin/coordinacionfirmante/_form.html.twig') }}</div>
        </div>
    </div>
{% endblock %}
