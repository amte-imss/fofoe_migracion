{% extends 'layouts/app.html.twig' %}

{% block title %}Nuevo Convenio{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('admin.convenio.styles') }}
    {{ encore_entry_link_tags('loader') }}
    {{ encore_entry_link_tags('admin.convenio.create') }}
{% endblock %}

{% block extra_js %}
    <script>
        window.MAX_DATE_ALLOWED = {{ maxDateAllowed|json_encode|raw }};
        window.Usuario = {{ usuarioJson|json_encode|raw }};
    </script>
    {{ encore_entry_script_tags('admin.convenio.create') }}
{% endblock %}

{% block body %}
    <div class="container-xl convenios-page py-4 py-lg-5">
        <a class="convenios-back" href="{{ path('admin.conveniosadmin.conveniosadmin.index') }}"><i class="ti ti-arrow-left"></i> Volver a convenios</a>
        <div class="convenios-heading mb-4">
            <div class="convenios-heading-icon"><i class="ti ti-file-plus"></i></div>
            <div>
                <div class="convenios-eyebrow">Gestión de Convenios</div>
                <h1>Nuevo convenio general</h1>
                <p>Completa los datos del convenio y sus firmantes.</p>
            </div>
        </div>
        <div class="convenios-card convenios-form-panel">
            <div class="convenios-card-header"><span>Datos del convenio</span><span class="convenios-required">* Campos obligatorios</span></div>
            <div class="convenios-card-body">{{ include('admin/convenioadmin/_form.html.twig') }}</div>
        </div>
    </div>
{% endblock %}
