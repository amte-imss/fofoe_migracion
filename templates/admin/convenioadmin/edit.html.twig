{% extends 'react_design/base.html.twig' %}

{% block title %}Edición de Convenio{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('loader') }}
    {{ encore_entry_link_tags('admin.convenio.edit') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.Convenio = {{ convenio|json_encode|raw }};
        window.MAX_DATE_ALLOWED = {{ maxDateAllowed|json_encode|raw }};
    </script>
    {{ encore_entry_script_tags('admin.convenio.edit') }}
{% endblock %}

{% block body %}
    <div class="col-md-11 content">
        <div class="row" style="margin-left: 2%; margin-top: 3%;">
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-6">
                                <h3>Edición del convenio {{ convenio.nombre }}</h3>
                                <h4>{{ convenio.fuica }}</h4>
                            </div>
                            <div class="col-md-6">
                                <a class="btn btn-secondary" href="{{ url('admin.conveniosadmin.conveniosadmin.index') }}">Regresar a la Lista de Convenios</a>
                            </div>
                        </div>
                        <br>
                        <div class="row">
                            <div class="col-md-7 text-danger">
                                * Campos Requeridos
                            </div>
                        </div>

                        {{ include('admin/convenioadmin/_form.html.twig') }}

                        <div class="row">
                            <div class="col-md-7 text-danger">
                                * Campos Requeridos
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
