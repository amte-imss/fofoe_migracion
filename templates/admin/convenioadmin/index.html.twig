{% extends 'layouts/app.html.twig' %}

{% block title %}Convenios generales — FOFOE{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('admin.convenio.styles') }}
    {{ encore_entry_link_tags('admin.convenio.index') }}
{% endblock %}

{% block body %}
    <div class="container-xl convenios-page py-4 py-lg-5">
        <div class="convenios-heading mb-4">
            <div class="convenios-heading-icon"><i class="ti ti-file-certificate"></i></div>
            <div>
                <div class="convenios-eyebrow">Gestión de Convenios</div>
                <h1>Convenios generales</h1>
                <p>Consulta, administra y exporta los convenios registrados.</p>
            </div>
        </div>
        <div class="react"></div>
    </div>
{% endblock %}

{% block extra_js %}
    <script>
        window.IS_CONVENIOS_OBSERVER = {{ is_convenios_observer|default(false)|json_encode }};
    </script>
    {{ encore_entry_script_tags('admin.convenio.index') }}
{% endblock %}
