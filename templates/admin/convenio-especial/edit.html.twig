{% extends 'layouts/app.html.twig' %}

{% block title %}Edición de Convenio Especial{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('admin.convenio.styles') }}
    {{ encore_entry_link_tags('loader') }}
    {{ encore_entry_link_tags('admin.convenio-especial.edit') }}
{% endblock %}

{% block extra_js %}
    <script>
        window.Convenio = {{ convenio|json_encode|raw }};
        window.MAX_DATE_ALLOWED = {{ maxDateAllowed|json_encode|raw }};
        window.Usuario = {{ usuarioJson|json_encode|raw }};
        window.MotivosColaboracion = {{ motivosColaboracion|json_encode|raw }};
        window.NivelesAcademicos = {{ nivelesAcademicos|json_encode|raw }};
        window.Poblaciones = {{ poblaciones|json_encode|raw }};
        window.Recursos = {{ recursos|json_encode|raw }};
    </script>
    {{ encore_entry_script_tags('admin.convenio-especial.edit') }}
{% endblock %}

{% block body %}
    <div class="container-xl convenios-page py-4 py-lg-5">
        <a class="convenios-back" href="{{ path('admin.convenios-especiales.index') }}"><i class="ti ti-arrow-left"></i> Volver a convenios especiales</a>
        <div class="convenios-heading mb-4">
            <div class="convenios-heading-icon"><i class="ti ti-edit"></i></div>
            <div>
                <div class="convenios-eyebrow">Gestión de Convenios{% if convenio.fuica %} · {{ convenio.fuica }}{% endif %}</div>
                <h1>Editar convenio especial</h1>
                <p>{{ convenio.nombre }}</p>
            </div>
        </div>
        <div class="convenios-card convenios-form-panel">
            <div class="convenios-card-header"><span>Datos del convenio</span><span class="convenios-required">* Campos obligatorios</span></div>
            <div class="convenios-card-body">{{ include('admin/convenio-especial/_form.html.twig') }}</div>
        </div>
    </div>
{% endblock %}
