{% extends 'layouts/app.html.twig' %}

{% block title %}Solicitudes de Enfermería{% endblock %}

{% block body %}
<div class="page-header">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Solicitudes de Enfermería</h2>
            <div class="text-muted mt-1">Total: {{ total }}</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <form method="GET" class="d-flex gap-2">
            <input type="text" name="q" class="form-control" placeholder="Buscar por escuela o unidad…" value="{{ q }}">
            <button type="submit" class="btn btn-secondary">Buscar</button>
            {% if q %}
                <a href="{{ path('admin.enfermeria.solicitudes.index') }}" class="btn btn-ghost-secondary">Limpiar</a>
            {% endif %}
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Escuela de Enfermería</th>
                    <th>Unidad</th>
                    <th>Periodo</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Fin</th>
                    <th>Alumnos</th>
                    <th>Creado</th>
                    <th>Es test</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for s in solicitudes %}
                <tr>
                    <td>{{ s.id }}</td>
                    <td>{{ s.unidad ? s.unidad.nombreEnfermeria : '—' }}</td>
                    <td>{{ s.unidad ? s.unidad.nombre : '—' }}</td>
                    <td>{{ s.periodoFormatted is defined ? s.periodoFormatted : s.periodo }}</td>
                    <td>{{ s.fechaInicioFormatted }}</td>
                    <td>{{ s.fechaFinFormatted ?? '—' }}</td>
                    <td>{{ s.alumnos|length }}</td>
                    <td>{{ s.createdAt ? s.createdAt|date('d/m/Y H:i') : '—' }}</td>
                    <td>
                        <span class="table-switch">
                            <span class="form-check form-switch"><input class="form-check-input" type="checkbox" {{ s.isTest ? 'checked' : '' }} disabled></span>
                            <span class="table-switch-label">{{ s.isTest ? 'Sí' : 'No' }}</span>
                        </span>
                    </td>
                    <td>
                        <a href="{{ path('admin.enfermeria.solicitud.show', {id: s.id}) }}" class="btn btn-sm btn-outline-primary">
                            <i class="ti ti-pencil me-1"></i>Modificar
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="10" class="text-center text-muted py-4">Sin resultados.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if total > perPage %}
    <div class="card-footer d-flex align-items-center">
        <p class="m-0 text-muted">Página {{ page }} de {{ (total / perPage)|round(0, 'ceil') }}</p>
        <ul class="pagination m-0 ms-auto">
            {% if page > 1 %}
            <li class="page-item"><a class="page-link" href="{{ path('admin.enfermeria.solicitudes.index', {page: page - 1, q: q}) }}">«</a></li>
            {% endif %}
            {% if page * perPage < total %}
            <li class="page-item"><a class="page-link" href="{{ path('admin.enfermeria.solicitudes.index', {page: page + 1, q: q}) }}">»</a></li>
            {% endif %}
        </ul>
    </div>
    {% endif %}
</div>
{% endblock %}
