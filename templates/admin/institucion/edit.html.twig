{% extends 'react_design/base.html.twig' %}

{% block title %}Edición de Institución{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('loader') }}
    {{ encore_entry_link_tags('admin.institucion.edit') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.Institucion = {{ institucion|json_encode|raw }};
        window.InstitucionHasCedula = {{ hasCedula|json_encode }};
    </script>
    {{ encore_entry_script_tags('admin.institucion.edit') }}
{% endblock %}

{% block body %}
    <div class="col-md-11 content">
        <div class="row" style="margin-left: 2%; margin-top: 3%;">
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-6">
                                <h3>Edición de la institución {{ institucion.razonSocial }}</h3>
                                <h4>{{ institucion.rfc }}</h4>
                            </div>
                            <div class="col-md-6">
                                <a class="btn btn-secondary" href="{{ url('admin.institucion.index') }}">Regresar a la Lista de Instituciones</a>
                            </div>
                        </div>
                        <br>
                        <div class="row">
                            <div class="col-md-7 text-danger">
                                * Campos Requeridos
                            </div>
                        </div>

                        {{ include('admin/institucion/_form.html.twig') }}

                        <div class="row">
                            <div class="col-md-7 text-danger">
                                * Campos Requeridos
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
