{% extends 'layouts/app.html.twig' %}

{% block title %}Editar institución — FOFOE{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('admin.convenio.styles') }}
    {{ encore_entry_link_tags('loader') }}
    {{ encore_entry_link_tags('admin.institucion.edit') }}
{% endblock %}

{% block body %}
    <div class="container-xl convenios-page py-4 py-lg-5">
        <a class="convenios-back" href="{{ path('admin.institucion.index') }}"><i class="ti ti-arrow-left"></i> Volver a instituciones</a>
        <div class="convenios-heading mb-4">
            <div class="convenios-heading-icon"><i class="ti ti-edit"></i></div>
            <div>
                <div class="convenios-eyebrow">Instituciones Educativas · {{ institucion.rfc }}</div>
                <h1>Editar institución</h1>
                <p>{{ institucion.razonSocial }}</p>
            </div>
        </div>
        <div class="convenios-card convenios-form-panel">
            <div class="convenios-card-header"><i class="ti ti-building"></i><span>Datos de la institución</span><span class="convenios-required">* Campos obligatorios</span></div>
            <div class="convenios-card-body">{{ include('admin/institucion/_form.html.twig') }}</div>
        </div>
    </div>
{% endblock %}

{% block extra_js %}
    <script>
        window.Institucion = {{ institucion|json_encode|raw }};
        window.InstitucionHasCedula = {{ hasCedula|json_encode }};
    </script>
    {{ encore_entry_script_tags('admin.institucion.edit') }}
{% endblock %}
