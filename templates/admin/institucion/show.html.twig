{% extends 'layouts/app.html.twig' %}

{% block title %}Detalle de institución — FOFOE{% endblock %}

{% block stylesheets %}{{ encore_entry_link_tags('admin.convenio.styles') }}{% endblock %}

{% macro field(label, value, width = 6) %}
    <div class="col-md-{{ width }}">
        <div class="convenios-detail-field">
            <span class="convenios-detail-label">{{ label }}</span>
            <p class="convenios-detail-value">{{ value ?: 'N/A' }}</p>
        </div>
    </div>
{% endmacro %}

{% block body %}
    {% import _self as ui %}
    <div class="container-xl convenios-page py-4 py-lg-5">
        <a class="convenios-back" href="{{ path('admin.institucion.index') }}"><i class="ti ti-arrow-left"></i> Volver a instituciones</a>
        <div class="convenios-heading mb-4">
            <div class="convenios-heading-icon"><i class="ti ti-building"></i></div>
            <div>
                <div class="convenios-eyebrow">Instituciones Educativas · {{ institucion.rfc }}</div>
                <h1>{{ institucion.razonSocial }}</h1>
                <p>Detalle de la institución</p>
            </div>
        </div>

        <section class="convenios-card convenios-detail-card">
            <div class="convenios-card-header"><i class="ti ti-building"></i><span>Información de la institución</span></div>
            <div class="convenios-card-body">
                <div class="row g-3">
                    {{ ui.field('RFC', institucion.rfc) }}
                    {{ ui.field('Razón social', institucion.razonSocial) }}
                    {{ ui.field('Nombre comercial', institucion.nombre) }}
                    {{ ui.field('OOAD', institucion.delegacion.nombre ?? '') }}
                    {{ ui.field('Correo', institucion.correo) }}
                    <div class="col-md-6"><div class="convenios-detail-field">
                        <span class="convenios-detail-label">Sitio web</span>
                        <p class="convenios-detail-value">
                            {% if institucion.sitioWeb starts with 'http://' or institucion.sitioWeb starts with 'https://' %}
                                <a href="{{ institucion.sitioWeb }}" target="_blank" rel="noopener noreferrer">{{ institucion.sitioWeb }}</a>
                            {% else %}{{ institucion.sitioWeb ?: 'N/A' }}{% endif %}
                        </p>
                    </div></div>
                    {{ ui.field('Dirección', institucion.direccion, 12) }}
                    {{ ui.field('Teléfono', institucion.telefono) }}
                    {{ ui.field('Extensión', institucion.extension) }}
                    {{ ui.field('Fax', institucion.fax) }}
                </div>
            </div>
        </section>
        {% if hasCedula %}
            <div class="mt-4"><a href="{{ path('name.institucion.cedula', {id: institucion.id}) }}" class="btn convenios-btn-primary" target="_blank" rel="noopener noreferrer"><i class="ti ti-file-type-pdf me-1"></i>Ver cédula fiscal</a></div>
        {% endif %}
    </div>
{% endblock %}
