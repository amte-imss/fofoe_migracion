{% extends 'react_design/base.html.twig' %}

{% block title %}Instituciones{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin.institucion.index') }}
{% endblock %}

{% block body %}
    {# Content #}
    <div class="col-md-11 content">
        <div class="row">
            <div class="col-md-12">
                <h3>Instituciones educativas</h3>
            </div>
            <div class="col-md-12">
                <div class="react"></div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.IS_CONVENIOS_OBSERVER = {{ is_convenios_observer|default(false)|json_encode }};
    </script>
    {{ encore_entry_script_tags('admin.institucion.index') }}
{% endblock %}
