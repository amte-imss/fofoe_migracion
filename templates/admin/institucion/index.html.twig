{% extends 'layouts/app.html.twig' %}

{% block title %}Instituciones educativas — FOFOE{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('admin.convenio.styles') }}
    {{ encore_entry_link_tags('admin.institucion.index') }}
{% endblock %}

{% block body %}
    <div class="container-xl convenios-page py-4 py-lg-5">
        <div class="convenios-heading mb-4">
            <div class="convenios-heading-icon"><i class="ti ti-building"></i></div>
            <div>
                <div class="convenios-eyebrow">Gestión de Convenios</div>
                <h1>Instituciones educativas</h1>
                <p>Consulta y administra el directorio de instituciones.</p>
            </div>
        </div>
        <div class="react"></div>
    </div>
{% endblock %}

{% block extra_js %}
    <script>window.IS_CONVENIOS_OBSERVER = {{ is_convenios_observer|default(false)|json_encode }};</script>
    {{ encore_entry_script_tags('admin.institucion.index') }}
{% endblock %}
