{% extends 'react_design/camebase.html.twig' %}

{% block body %}
    <div class="jumbotron" style="width: 90%;">
        <div class="container" style="margin-top: 6%;">
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <a class="btn btn-primary"
                       href="{{ url('admin.convenioscame.convenioscame.index', {page: 1}) }}"
                       title="Lista de Convenios">
                        Regresar a la lista de convenios
                    </a>
                </div>
            </div>
        </div>
        <div class="container cstmContainer">
            <h1 class="display-10">Convenio {{ convenio.nombre }}</h1>
            <h3>Información de convenio</h3>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">R.F.C. de Convenio</span>
                        <p class="textValueShowConvenio">{{ convenio.rfc ?: 'N/A' }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Razón Social</span>
                        <p class="textValueShowConvenio">{{ convenio.razonSocial ?: 'N/A' }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Nombre Comercial</span>
                        <p class="textValueShowConvenio">{{ convenio.nombre }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Institución</span>
                        <p class="textValueShowConvenio">{{ convenio.institucion }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Convenio General al que se Asocia</span>
                        <p class="textValueShowConvenio">{{ convenio.convenioGeneral ?: 'N/A' }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">OOAD</span>
                        <p class="textValueShowConvenio">{{ convenio.convenioDelegacionesFormatted }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Sector</span>
                        <p class="textValueShowConvenio">{{ convenio.sector }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Objetivo de la Colaboración</span>
                        <p class="textValueShowConvenio">{{ convenio.objetivoColaboracion ?: 'N/A' }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Campos Clínicos</span>
                        <p class="textValueShowConvenio">{{ convenio.ciclosAcademicosFormatted }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Nivel o Grado Académico</span>
                        <p class="textValueShowConvenio">{{ convenio.nivelAcademico.nombre ?? 'N/A' }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Disciplina</span>
                        <p class="textValueShowConvenio">{{ convenio.disciplina.nombre ?? 'N/A' }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Carrera</span>
                        <p class="textValueShowConvenio">{{ convenio.carrera }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Nombre del Programa</span>
                        <p class="textValueShowConvenio">{{ convenio.nombrePrograma ?: 'N/A' }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Fecha de Firma</span>
                        <p class="textValueShowConvenio">{{ convenio.fechaFirma ? convenio.fechaFirma|date('d-m-Y') : 'N/A' }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Vigencia (años)</span>
                        <p class="textValueShowConvenio">{{ convenio.vigenciaText ? convenio.vigenciaText|replace({'year': 'año'}) : 'N/A' }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Fecha de Vigencia de Convenio</span>
                        <p class="textValueShowConvenio">{{ convenio.fechaVenceConvenio ? convenio.fechaVenceConvenio|date('d-m-Y') : 'N/A' }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Fecha de Emisión OTA</span>
                        <p class="textValueShowConvenio">{{ convenio.fechaOta ? convenio.fechaOta|date('d-m-Y') : 'N/A' }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Fecha de Vigencia de Emisión OTA</span>
                        <p class="textValueShowConvenio">{{ convenio.fechaVenceOta ? convenio.fechaVenceOta|date('d-m-Y') : 'N/A' }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Fecha de Emisión RVOE</span>
                        <p class="textValueShowConvenio">{{ convenio.fechaRvoe ? convenio.fechaRvoe|date('d-m-Y') : 'N/A' }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Fecha de Vigencia de Emisión RVOE</span>
                        <p class="textValueShowConvenio">{{ convenio.fechaVenceRvoe ? convenio.fechaVenceRvoe|date('d-m-Y') : 'N/A' }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Fecha de Emisión de Acreditación (COMAEM u otros)</span>
                        <p class="textValueShowConvenio">{{ convenio.fechaEmiteComaem ? convenio.fechaEmiteComaem|date('d-m-Y') : 'N/A' }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Fecha de Vigencia de Emisión de Acreditación (COMAEM u otros)</span>
                        <p class="textValueShowConvenio">{{ convenio.fechaVenceComaem ? convenio.fechaVenceComaem|date('d-m-Y') : 'N/A' }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">FUICA</span>
                        <p class="textValueShowConvenio">{{ convenio.fuica ?: 'N/A' }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Número de Convenio</span>
                        <p class="textValueShowConvenio">{{ convenio.numero ?: 'N/A' }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12"><h2>Firmantes</h2></div>
            </div>
            <div class="row">
                <div class="col-md-6"><h3>Por el IMSS</h3></div>
                <div class="col-md-6"><h3>Por la Institución Educativa</h3></div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Cargo</span>
                        <p class="textValueShowConvenio">{{ convenio.cargoFirmaIdFirst.nombre ?? 'N/A' }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Cargo</span>
                        <p class="textValueShowConvenio">{{ convenio.cargoEmiteSignfirst ?: 'N/A' }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Nombre</span>
                        <p class="textValueShowConvenio">{{ convenio.recibeSignfirst ?: 'N/A' }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Nombre</span>
                        <p class="textValueShowConvenio">{{ convenio.nombreEmiteSignfirst ?: 'N/A' }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Cargo</span>
                        <p class="textValueShowConvenio">{{ convenio.cargoFirmaIdSecond.nombre ?? 'N/A' }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Cargo</span>
                        <p class="textValueShowConvenio">{{ convenio.cargoEmiteSignsecond ?: 'N/A' }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Nombre</span>
                        <p class="textValueShowConvenio">{{ convenio.recibeSignsecond ?: 'N/A' }}</p>
                    </div>
                </div>
                <div class="col-md-6" style="text-align: justify;">
                    <div class="well">
                        <span class="textLabelShowConvenio">Nombre</span>
                        <p class="textValueShowConvenio">{{ convenio.nombreEmiteSignsecond ?: 'N/A' }}</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="container" style="margin-top: 6%;">
            <div class="row">
                <div class="col-md-6" style="text-align: justify;">
                    <a class="btn btn-primary"
                       href="{{ url('admin.convenioscame.convenioscame.index', {page: 1}) }}"
                       title="Lista de Convenios">
                        Regresar a la lista de convenios
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
