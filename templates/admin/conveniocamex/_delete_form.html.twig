<form method="post"
      action="{{ path('admin.convenioscame.convenioscame.delete', {id: convenio.id}) }}"
      onsubmit="return confirm('¿Estás seguro de borrar este convenio?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ convenio.id) }}">
    <button type="submit" class="btn btn-danger mb-2" style="width: 10rem;">Eliminar</button>
</form>
