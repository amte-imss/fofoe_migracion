{% extends 'react_design/camebase.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin.came.convenio.index') }}
{% endblock %}

{% block body %}
    {# Content #}
    <div class="col-md-11 content">
        <div class="row">
            <div class="col-md-12">
                <h3>Convenios OOAD/UMAE</h3>
            </div>
            <div class="col-md-12">
                <div class="react"></div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.Usuario = {{ usuarioJson|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
    </script>
    {{ encore_entry_script_tags('admin.came.convenio.index') }}
{% endblock %}
