{% extends 'layouts/app.html.twig' %}

{% block stylesheets %}
    {{ encore_entry_link_tags('came_solicitud_index') }}
    <style>
        .wrapper-came {
            margin-top: 80px;
            margin-bottom: 80px;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container-fluid wrapper-came">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <h1 style="text-align: center; padding-bottom: 40px">
                        Solicitudes de Campos Clínicos
                    </h1>
                </div>
            </div>
            <div id="solicitudes-table"></div>
        </div>
    </div>
{% endblock %}

{% block extra_js %}
    <script>
        window.SOLICITUDES = {{ solicitudes | json_encode | raw }};
        window.META = {{ meta | json_encode | raw }};
    </script>
    {{ encore_entry_script_tags('came_solicitud_index') }}
{% endblock %}
