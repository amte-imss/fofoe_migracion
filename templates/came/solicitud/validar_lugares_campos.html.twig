{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('came_solicitud_validar') }}
    <style>
        .wrapper-came {
            margin-top: 80px;
            margin-bottom: 80px;
        }
    </style>
{% endblock %}

{% block body %}
    {{ render(controller('App\\Controller\\Came\\CameController::menu')) }}
    <div class='container-fluid wrapper-came'>
        <div class="container">
            <a href="{{ path('came.solicitud.index') }}">Regresar</a>
            <div class='row'>
                <div class='col-md-12'>
                    <h1 style="text-align: center; padding-bottom: 40px">Validar solicitud de campos clínicos</h1>
                </div>
            </div>
            <div id="solicitud-validate-wrapper"></div>
            <a href="{{ path('came.solicitud.index') }}">Regresar</a>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('came_solicitud_validar') }}
    <script>
        window.SOLICITUD = {{ solicitud | json_encode | raw }};
    </script>
{% endblock %}
