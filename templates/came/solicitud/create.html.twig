{% extends 'layouts/app.html.twig' %}

{% block title %}Nueva solicitud de Campos Educativos{% endblock %}

{% block body %}
<div class="container-xl py-4">
    <div class="page-header mb-4">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">Nueva solicitud de Campos Educativos</h2>
                <div class="text-muted mt-1">Registro de solicitud de campos clinicos por ciclo educativo.</div>
            </div>
            <div class="col-auto">
                <a href="{{ path('came.solicitud.index') }}" class="btn btn-outline-secondary spa-link">
