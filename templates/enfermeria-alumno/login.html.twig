{% extends 'enfermeria-alumno/_layout.html.twig' %}

{% block title %}Acceso — Escuela de Enfermería IMSS{% endblock %}
{% block submenu %}{% endblock %}
{% block menu_bar %}{% endblock %}

{% block body %}
    <main class="nursing-page nursing-login-page">
        <div class="container py-4 py-md-5">
            <div class="nursing-login-grid">
                <section class="nursing-login-intro" aria-labelledby="nursing-login-title">
                    <div class="nursing-heading-icon"><i class="ti ti-school"></i></div>
                    <span class="nursing-eyebrow">Portal del alumno</span>
                    <h1 id="nursing-login-title">Escuelas de Enfermería del IMSS</h1>
                    <p>Consulta el estado de tu proceso y registra el comprobante de pago de tu licenciatura.</p>
                    <div class="nursing-school-card">
                        <span>Escuela</span>
                        <strong>{{ solicitud.unidad.nombreEnfermeria }}</strong>
                        <div class="nursing-school-period">
                            <span><i class="ti ti-calendar"></i> {{ solicitud.periodo|capitalize }}</span>
                            <span>{{ solicitud.fechaInicioFormatted }} — {{ solicitud.fechaFinFormatted }}</span>
                        </div>
                    </div>
                </section>

                <section class="nursing-card nursing-login-card" aria-labelledby="nursing-access-title">
                    <div class="nursing-card-header"><i class="ti ti-login-2"></i><div><h2 id="nursing-access-title">Ingresa a tu cuenta</h2><p>Usa los datos registrados por tu escuela.</p></div></div>
                    <div class="nursing-card-body">
                        {% if error_login %}<div class="alert alert-danger" role="alert">{{ error_login }}</div>{% endif %}
                        {% if error_captcha %}<div class="alert alert-warning" role="alert">El código de seguridad no coincide. Genera uno nuevo e inténtalo otra vez.</div>{% endif %}
                        <form id="form-login-enf" class="form nursing-login-form" action="{{ path('enfermeria-alumno.login', {solicitudId: solicitud.id}) }}" method="post">
                            <div class="form-group">
                                <label for="f-username">CURP <span class="text-danger">*</span></label>
                                <input id="f-username" type="text" name="alumno_login[curp]" class="form-control form__input" autocomplete="username" maxlength="18" required autofocus>
                                <span class="form__error f-username-error" aria-live="polite"></span>
                            </div>
                            <div class="form-group">
                                <label for="password">Correo electrónico <span class="text-danger">*</span></label>
                                <input id="password" type="email" name="alumno_login[email]" class="form-control form__input" autocomplete="email" required>
                                <span class="form__error password-error" aria-live="polite"></span>
                            </div>
                            <div class="captcha-before"></div>
                            <label class="nursing-consent" for="f-agreement">
                                <input id="f-agreement" type="checkbox" name="accept_agreement" class="form__input" required>
                                <span>Acepto las <a href="{{ path('agreement_privacy.index') }}" target="_blank" rel="noopener noreferrer">políticas de pago de cuotas de recuperación al FOFOE</a>.</span>
                            </label>
                            <span class="form__error f-agreement-error" aria-live="polite"></span>
                            <button type="submit" class="btn nursing-btn-primary btn-block form__submit mt-4"><i class="ti ti-arrow-right mr-1"></i> Ingresar</button>
                        </form>
                    </div>
                </section>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>window.SolicitudId = {{ solicitud.id|json_encode|raw }};</script>
    {{ encore_entry_script_tags('enfermeria-alumno.login') }}
{% endblock %}
