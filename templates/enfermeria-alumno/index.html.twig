{% extends 'enfermeria-alumno/_layout.html.twig' %}

{% block title %}Mi proceso — Escuela de Enfermería IMSS{% endblock %}

{% block body %}
    <main class="nursing-page">
        <div class="container py-4 py-md-5">
            <div class="nursing-page-heading mb-4">
                <div class="nursing-heading-icon"><i class="ti ti-school"></i></div>
                <div><span class="nursing-eyebrow">Portal del alumno</span><h1>Mi proceso</h1><p>Consulta tu información y el estado de tu pago.</p></div>
            </div>
            <div id="wrapper-page"></div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') %}
    <script>window.Usuario = {{ usuario|json_encode(json_flags)|raw }};</script>
    {{ encore_entry_script_tags('enfermeria-alumno.index') }}
{% endblock %}
