{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('build/loader.css') }}">
    <link rel="stylesheet" href="{{ asset('build/enfermeria-alumno.css') }}">
    <link rel="stylesheet" href="{{ asset('build/popup.css') }}">
    <style>
        .wrapper-page{
            margin-top: 20px;
            margin-bottom: 80px;
        }

        embed {
            width: 100%;
            height: 80vh;
        }
    </style>
{% endblock %}

{% block body %}
    {{ render(controller('App\\Controller\\Enfermeria\\AlumnoController::menu')) }}

    <div class="section-md">
        <div class='container-fluid'>
            <div class='container'>
                <h1 class="text-bold text-center mb-20">Bienvenido {{ usuario.nombre }}</h1>
                <div class="row">
                    <div class="col-md-12">
                        <div id="wrapper-page"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.Usuario = {{ usuario | json_encode | raw }};
    </script>
    <script src="{{ asset('build/enfermeria-alumno.index.js') }}"></script>
{% endblock %}
