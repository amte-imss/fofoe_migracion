{% extends 'layouts/ie.html.twig' %}

{% block title %}Acceso no válido — FOFOE{% endblock %}

{% block body %}
<div class="section-md">
    <div class="container text-center" style="padding: 60px 20px;">
        <div style="font-size: 64px; margin-bottom: 20px;">🔒</div>
        <h2>Acceso no válido</h2>
        <p class="text-muted">
            Para acceder al portal de alumnos necesitas usar el enlace de acceso<br>
            que fue enviado a tu correo electrónico al momento de tu registro.
        </p>
        <p class="text-muted" style="margin-top: 10px;">
            El enlace tiene el formato:<br>
            <code>{{ app.request.schemeAndHttpHost }}/enfermeria-alumno/login/<strong>{id de tu solicitud}</strong></code>
        </p>
        <p class="text-muted" style="margin-top: 20px;">
            Si tienes dudas, contacta a <a href="mailto:factura.fofoe@imss.gob.mx">factura.fofoe@imss.gob.mx</a>
        </p>
    </div>
</div>
{% endblock %}
