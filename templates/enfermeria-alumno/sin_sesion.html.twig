{% extends 'enfermeria-alumno/_layout.html.twig' %}

{% block title %}Acceso no válido — Escuela de Enfermería IMSS{% endblock %}
{% block submenu %}{% endblock %}
{% block menu_bar %}{% endblock %}

{% block body %}
    <main class="nursing-page nursing-empty-page">
        <div class="container py-5">
            <section class="nursing-card nursing-empty-card">
                <div class="nursing-heading-icon mx-auto"><i class="ti ti-lock"></i></div>
                <span class="nursing-eyebrow">Portal del alumno</span>
                <h1>Acceso no válido</h1>
                <p>Para ingresar utiliza el enlace que recibiste por correo al momento de tu registro.</p>
                <div class="nursing-access-example">/enfermeria-alumno/login/<strong>{id de tu solicitud}</strong></div>
                <p class="mb-0">Si necesitas ayuda, escribe a <a href="mailto:factura.fofoe@imss.gob.mx">factura.fofoe@imss.gob.mx</a>.</p>
            </section>
        </div>
    </main>
{% endblock %}
