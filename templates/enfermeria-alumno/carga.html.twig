{% extends 'enfermeria-alumno/_layout.html.twig' %}

{% block title %}Cargar comprobante — Escuela de Enfermería IMSS{% endblock %}

{% block body %}
    <main class="nursing-page">
        <div class="container py-4 py-md-5">
            <a class="nursing-back" href="{{ path('enfermeria-alumno.index') }}"><i class="ti ti-arrow-left"></i> Volver a mi proceso</a>
            <div class="nursing-page-heading mb-4">
                <div class="nursing-heading-icon"><i class="ti ti-file-upload"></i></div>
                <div><span class="nursing-eyebrow">Pago de licenciatura</span><h1>Cargar comprobante de pago</h1><p>Registra los datos del pago y adjunta tu comprobante en PDF.</p></div>
            </div>
            <div id="wrapper-page"></div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') %}
    <script>window.Usuario = {{ usuario|json_encode(json_flags)|raw }};</script>
    {{ encore_entry_script_tags('enfermeria-alumno.cargaComprobante') }}
{% endblock %}
