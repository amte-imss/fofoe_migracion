{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('loader') }}
    {{ encore_entry_link_tags('enfermeria-alumno') }}
    <style>
        .wrapper-page {
            margin-top: 20px;
            margin-bottom: 80px;
        }

        .iframe {
            border: 1px solid lightgray;
            width: 100%;
            height: 50vh;
        }
    </style>
{% endblock %}

{% block body %}
    {{ render(controller('App\\Controller\\Enfermeria\\AlumnoController::menu')) }}
    <div class="section-md">
        <div class="container-fluid">
            <div class="container">
                <h1 class="text-bold text-center mb-20">Carga de comprobante de pago</h1>
                <div class="row">
                    <div class="col-md-12">
                        <div id="wrapper-page"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.Usuario = {{ usuario|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }};
    </script>
    {{ encore_entry_script_tags('enfermeria-alumno.cargaComprobante') }}
{% endblock %}
