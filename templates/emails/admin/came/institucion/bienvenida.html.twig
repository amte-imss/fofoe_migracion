{% extends 'emails/base.html.twig' %}

{% block preheader %}
    <span class="preheader">Bienvenido a FOFOE. </span>
{% endblock %}

{% block body %}
    <td>
        <main>
            <h1 class="text-center text-green">Sistema de Administración del FOFOE</h1>
            <p>Estimado, {{ usuario.fullName }}</p>

            <p>El Instituto Mexicano del Seguro Social.</p>

            <p>A continuación, te compartimos tus credenciales y la liga de acceso.</p>

            <p>OOAD: <strong>{{ usuario.delegacionInstitucion.nombre ?? '' }}</strong></p>
            <p>Institución: <strong>{{ usuario.institucion.nombre ?? '' }}</strong></p>
            {% if usuario.campus %}
                <p>Campus: <strong>{{ usuario.campus.nombre }}</strong></p>
            {% endif %}

            <p>Usuario: <strong>{{ usuario.matricula }}</strong></p>
            {% if usuario.plainPassword %}
                <p>Contraseña: <strong>{{ usuario.plainPassword }}</strong></p>
            {% endif %}
            <p>Liga: <strong><a href="https://educast.imss.gob.mx/sys/fofoe/login">https://educast.imss.gob.mx/sys/fofoe/login</a></strong></p>

            <p>La plataforma está abierta las 24 horas los 365 días del año.</p>

            <p>Recibe un cordial saludo y quedamos a tus órdenes para cualquier aclaración o duda; comunícate con nosotros por medio del correo electrónico <a href="mailto:factura.fofoe@imss.gob.mx">factura.fofoe@imss.gob.mx</a>.</p>

            <div class="text-center text-green">
                <p>Atentamente</p>
                <br><br>
                Sistema de Administración del FOFOE
            </div>
        </main>
    </td>
{% endblock %}
