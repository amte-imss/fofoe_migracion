{% extends 'emails/base.html.twig' %}

{% block preheader %}
    <span class="preheader">Nuevo comprobante de pago recibido.</span>
{% endblock %}

{% block body %}
    {% set usuario = residente.usuario %}
    {% set homepage_url = url('homepage') %}

    <td>
        <main>
            <h1 class="text-center text-green">Sistema de Administración del FOFOE</h1>
            <p>Por medio del presente, se le notifica que el residente <strong>{{ usuario.nombre }} {{ usuario.apellidoPaterno }} {{ usuario.apellidoMaterno }}</strong>
                ha registrado un pago para la residencia <strong>{{ residencia.folio }}</strong> de campos clínicos
                en el <strong>Sistema de Administración del FOFOE</strong>.</p>

            <p>Puede consultar el estado y realizar la validación del pago accediendo mediante la siguiente liga:</p>

            <p class="text-center"><a href="{{ homepage_url }}">{{ homepage_url }}</a></p>

            <p>Sin otro particular, reciba un cordial saludo.</p>

            <div class="text-center text-green">
                <p>Atentamente</p>
                <br><br>
                Sistema de Administración del FOFOE
            </div>
        </main>
    </td>
{% endblock %}
