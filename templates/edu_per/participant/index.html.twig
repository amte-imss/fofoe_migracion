{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    
    <style>
        .wrapper-page{
            margin-top: 20px;
            margin-bottom: 80px;
        }

        embed {
            width: 100%;
            height: 80vh;
        }
    </style>
{% endblock %}

{% block body %}
    {% include 'edu_per/participant/_menu.twig' %}

    <div class="section-md">
        <div class='container-fluid'>
            <div class='container'>
                <h1 class="text-bold text-center mb-20">Bienvenido {{ solicitud.participant }}</h1>
                <div class="row">
                    <div class="col-md-12">
                        <div id="wrapper-page"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.Solicitud = {{ solicitud | json_encode | raw }};
    </script>
    {{ encore_entry_script_tags('edu-per.participant.index') }}
{% endblock %}
