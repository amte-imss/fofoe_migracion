{% extends 'layouts/app.html.twig' %}

{% block title %}FOFOE — Reportes{% endblock %}

{% block body %}
<div class="container-xl py-4">
    <div class="page-header mb-4">
        <h2 class="page-title">Reportes</h2>
        <div class="text-muted mt-1">Consulta de reportes FOFOE disponibles para tu usuario.</div>
    </div>

    <div class="row g-3">
        {% if is_granted('ROLE_FOFOE_REPORTE_INGS') %}
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">Reporte de ingresos</h3>
                        <p class="text-muted">Pendiente de migrar la pantalla funcional.</p>
                    </div>
                </div>
            </div>
        {% endif %}
        {% if is_granted('ROLE_FOFOE_REPORTE_OP') %}
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">Reporte de oportunidad de pago</h3>
                        <p class="text-muted">Pendiente de migrar la pantalla funcional.</p>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
