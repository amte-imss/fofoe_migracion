{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('fofoe.registrar.factura') }}
{% endblock %}

{% block body %}
    {{ render(controller('App\\Controller\\Fofoe\\FofoeController::menu')) }}

    <div class="section-md">
        <div class='container-fluid'>
            <div class='container'>
                <h1 class="text-bold text-center">Registrar - factura(s) de la solicitud</h1>
                <div class="row">
                    <div class="col-md-12">
                        <div id="registrar-factura-component"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('fofoe.registrar.factura') }}
    <script>
        window.INSTITUCION_PROP = {{ institucion | json_encode | raw }};
        window.SOLICITUD_PROP   = {{ solicitud   | json_encode | raw }};
        window.PAGOS_PROP       = {{ pagos       | json_encode | raw }};
        window.ERRORS_PROPS     = {{ errors      | json_encode | raw }};
    </script>
{% endblock %}
